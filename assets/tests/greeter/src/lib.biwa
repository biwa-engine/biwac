// 依存パッケージの型を公開 API に露出させるライブラリ。
//
// 意図: シグニチャや struct メンバに *依存パッケージで定義された型* が現れたとき、
// .biwameta がそれを外部シンボル参照 (DiskTyKind::ExternalDefined) として書き出し、
// 依存元がそれを復元できることを確認する。
// 以前は自パッケージのシンボル表しか引けず、外部の型は黙ってシンボル 0 番に化けていた。

// 引数も戻り値も std で定義された型。
fn greet(name: std::types::string::String) -> std::types::string::String {
  return name.concat("!");
}

// struct のメンバが依存パッケージの型。
struct Greeting {
  message: std::types::string::String,
}

impl Greeting {
  fn new(message: std::types::string::String) -> Self {
    Self {
      message = message,
    }
  }

  fn message(self) -> std::types::string::String {
    self.message
  }
}

// 戻り値が color の型。
// greeter を使う側から見ると、color は推移的な依存になる。
fn theme() -> color::Rgb {
  return color::Rgb::white();
}

// ジェネリックな型。
//
// 使う側は `type IntBox = greeter::Box[Int];` のようにエイリアスを張り、
// そのエイリアス越しに `IntBox::new(1)` と関連関数を引けなければならない。
// エイリアスの右辺が外部パッケージの型を指す場合、canonical な型は
// 使う側の名前ツリーに居ないので、依存メタデータまで降りる必要がある。
struct Box[T] {
  value: T,
}

impl[T] Box[T] {
  fn new(value: T) -> Self {
    Self {
      value = value,
    }
  }

  fn get(self) -> T {
    self.value
  }
}

// 型の振る舞いを表す trait。
//
// 使う側 (test1) がこの trait を import して
// 自分の型に実装できることを確認する。
// trait 自身がこのパッケージのものなので、孤児則は満たされる。
trait Describe {
  fn describe(self) -> Int;

  fn from_code(code: Int) -> Self;
}

// 自パッケージの trait を自パッケージの型に実装する。
impl Greeting: Describe {
  fn describe(self) -> Int {
    return 1;
  }

  fn from_code(code: Int) -> Self {
    return Greeting::new(greet("code"));
  }
}
