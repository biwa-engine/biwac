// Option[T] 型
//
// enum で書かれている。
// 実際の std と同じく、payload が生の型のまま入る。
enum Option[T] {
  None,
  Some(T),
}

impl[T] Option[T] {
  fn none() -> Self {
    Option::None
  }

  fn some(value: T) -> Self {
    Option::Some(value)
  }

  fn is_some(self) -> Bool {
    match self {
      Option::Some(_) => TRUE,
      Option::None => FALSE,
    }
  }
}
