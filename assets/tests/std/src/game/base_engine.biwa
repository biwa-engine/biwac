// エンジン (基盤ランタイム) との境界。
//
// エンジンの API はシステムコールにあたる。呼ぶとエンジン側 (kernel land) に入る。
//
// - 中断する syscall (クリック待ちなど) は、scene から `yield` で発行される。
//   ここにある関数は「レジスタに積む」役だけを持ち、syscall の記述子を組み立てて返す。
//   実際に制御を渡す `yield` 命令はコンパイラが scene の中に置く。
//   中断できるのは generator である scene だけなので、この形になる。
// - 中断しない syscall (画像を出す、名前を変える) は普通の関数呼び出しでよい。
//   エンジンの API をそのまま呼び、積んで即座に返る。
//
// `@biwa/engine/*` は生成物の配置場所に依存しないための論理パスで、
// Biwa CLI が用意する Vite の alias / tsconfig の paths によって
// 実際のエンジン実装 (`.biwa_runtime/src/engine/...`) へ解決される。
[[native(arch="typescript")]]
{{
  import {
    addTransition,
    allocObjectId,
    createObject,
    deleteObject,
    startTransitions,
  } from "@biwa/engine/api/object";
  import {
    clearContent,
    flushContent,
    pushContentText,
  } from "@biwa/engine/api/message";
  import { Sys, type BiwaSyscall } from "@biwa/engine/vm/syscall";
}}

// wasm ではエンジンの API をホスト関数の import として宣言する。
//
// import の名前空間 (`biwa:engine`) は std とエンジンが合意するものであり、
// コンパイラは関知しない。コンパイラはこの宣言をそのまま生成物の先頭に置く。
//
// wasm には中断の仕組みが無く、その必要も無い。
// エンジン呼び出しは同期的なホスト関数の呼び出しで、
// 完了までブロックするか積んで即座に返るかはエンジンの都合である。
// したがって typescript 版と違い syscall の記述子を返さない。
[[native(arch="wasm")]]
{{
  (import "biwa:engine" "sys_content_push_text"
    (func $sys_content_push_text
      (param externref f32 i32 f32 i32 i32 i32 i32 i32)))
  (import "biwa:engine" "sys_content_flush" (func $sys_content_flush))
  (import "biwa:engine" "sys_content_clear" (func $sys_content_clear))
  (import "biwa:engine" "sys_wait" (func $sys_wait))
  (import "biwa:engine" "sys_create_object"
    (func $sys_create_object
      (param externref i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (import "biwa:engine" "sys_delete_object" (func $sys_delete_object (param i32 i32)))
  (import "biwa:engine" "sys_add_transition"
    (func $sys_add_transition (param i32 i32 i32 i32 i32 i32)))
  (import "biwa:engine" "sys_start_transitions" (func $sys_start_transitions (param i32)))
  (import "biwa:engine" "sys_await_transitions" (func $sys_await_transitions))
  (import "biwa:engine" "sys_sleep" (func $sys_sleep (param i32)))
  (import "biwa:engine" "sys_string_concat"
    (func $sys_string_concat (param externref externref) (result externref)))
  (import "biwa:engine" "sys_int_to_string"
    (func $sys_int_to_string (param i32) (result externref)))
  (import "biwa:engine" "sys_float_to_string"
    (func $sys_float_to_string (param f32) (result externref)))
  (import "biwa:engine" "sys_vec_new" (func $sys_vec_new (result externref)))
  (import "biwa:engine" "sys_vec_of" (func $sys_vec_of (param anyref) (result externref)))
  (import "biwa:engine" "sys_vec_push" (func $sys_vec_push (param externref anyref)))
  (import "biwa:engine" "sys_vec_len" (func $sys_vec_len (param externref) (result i32)))
  (import "biwa:engine" "sys_vec_get"
    (func $sys_vec_get (param externref i32) (result anyref)))
  (import "biwa:engine" "sys_map_insert" (func $sys_map_insert (param externref anyref anyref)))
  (import "biwa:engine" "sys_map_get" (func $sys_map_get (param externref anyref) (result anyref)))
}}

import package::string::String;
import package::game::window::Size;

// syscall の記述子。中身はエンジンとの規約であり、Biwa 側からは不透明。
[[lang="syscall"]]
[[native(arch="typescript")]]
type Syscall = {{
  BiwaSyscall
}};

// wasm では syscall の記述子という概念が要らない
// (エンジン呼び出しがそのままホスト関数の呼び出しになる) が、
// lang item `syscall` は今のところターゲットに関係なく要求されるので、
// 満たすためだけのダミーを置いておく。
//
// TODO: 要求する lang item を arch ごとに変えられるようにして、これを消す。
[[lang="syscall"]]
[[native(arch="wasm")]]
type Syscall = {{
  i32
}};

// --- canvas オブジェクト ---------------------------------------------------
//
// 座標は canvas の中央が原点で、x は右が正、y は**上が正**である。
// 位置と回転はどちらも画像の中心を基準にする。
// パラメータの番号 (param) と遷移の種類 (kind) はエンジンとの取り決めで、
// 一覧は engine の `src/engine/api/transition.ts` にある。
// 設計は `docs/media-object-model.md` を参照。

// オブジェクトを canvas に置き、その id を返す。
//
// `path` はパッケージの `assets/` を基準とした相対パスである。
// `w` / `h` が負なら「指定しない」で、画像の元のサイズから決まる。
// 片方だけ正ならアスペクトを保つ。
//
// 読み込みは非同期だが、この呼び出しは待たない。
// 読み込みに失敗しても id は返る (ゲーム側にできることが無いため)。
[[native(arch="typescript")]]
fn sys_create_object(
  path: String, layer: Uint,
  x: Int, y: Int, w: Int, h: Int, alpha: Int, theta: Int,
) -> Uint {{
  const id = allocObjectId();
  createObject(id, path, layer, x, y, w, h, alpha, theta);
  return id;
}}

[[native(arch="wasm")]]
fn sys_create_object(
  path: String, layer: Uint,
  x: Int, y: Int, w: Int, h: Int, alpha: Int, theta: Int,
) -> Uint {{
  local.get 0
  local.get 1
  local.get 2
  local.get 3
  local.get 4
  local.get 5
  local.get 6
  local.get 7
  call $sys_create_object
}}

struct X {
  x: Size,
}

impl X {
  fn vw(vw: Float) -> Self {
    Self { x = Size::Vw(vw) }
  }
}

struct Y {
  y: Size,
}

impl Y {
  fn vh(vh: Float) -> Self {
    Self { y = Size::Vh(vh) }
  }
}

fn create_object(
  path: String, layer: Uint,
  x: Int, y: Int, w: Int, h: Int, alpha: Int, theta: Int,
) -> Uint {
  sys_create_object(path, layer, x, y, w, h, alpha, theta)
}

// `after` ミリ秒後にオブジェクトを消す。
//
// 完全に透明にしただけでは資源は解放されない。
// 消えるアニメーションを出したあとは、その終わりに合わせてこれを呼ぶ。
[[native(arch="typescript")]]
fn delete_object(id: Uint, after: Uint) {{
  deleteObject(id, after);
}}

[[native(arch="wasm")]]
fn delete_object(id: Uint, after: Uint) {{
  local.get 0
  local.get 1
  call $sys_delete_object
}}

// 次の `start_transitions` に備えて遷移を積む。積むだけで何も起きない。
//
// `value` は一度限りの遷移では目標値、周期的な遷移では振幅。
// `after` は発火からの遅れ、`duration` は遷移時間 (周期系では周期)。
[[native(arch="typescript")]]
fn add_transition(id: Uint, param: Uint, kind: Uint, value: Int, after: Uint, duration: Uint) {{
  addTransition(id, param, kind, value, after, duration);
}}

[[native(arch="wasm")]]
fn add_transition(id: Uint, param: Uint, kind: Uint, value: Int, after: Uint, duration: Uint) {{
  local.get 0
  local.get 1
  local.get 2
  local.get 3
  local.get 4
  local.get 5
  call $sys_add_transition
}}

// 積まれた遷移を発火する。オブジェクトを跨いで一斉に始まる。
//
// 置き換わるのは積まれた遷移が触れているパラメータだけなので、
// 別のオブジェクトや別のパラメータで走っているアニメーションは壊れない。
//
// `sync` が 0 でなければ、この演出はテキストの進行と結びつく。
// クリックはまずこれを完了させ、`await_transitions` が待つ対象にもなる。
[[native(arch="typescript")]]
fn start_transitions(sync: Uint) {{
  startTransitions(sync);
}}

[[native(arch="wasm")]]
fn start_transitions(sync: Uint) {{
  local.get 0
  call $sys_start_transitions
}}

// sync 印の演出がすべて終わるまでシーンを止める。
//
// NOTE: wasm ターゲット専用である。TypeScript ターゲットで `yield` を置けるのは
// 今のところ novel statement の展開先だけで、任意の呼び出しを中断させる手段が
// コンパイラに無い。
[[native(arch="wasm")]]
fn await_transitions() {{
  call $sys_await_transitions
}}

// エンジン時計の上で指定時間シーンを止める (ポーズ中は進まない)。
// `await_transitions` と同じく wasm ターゲット専用。
[[native(arch="wasm")]]
fn sleep(ms: Uint) {{
  local.get 0
  call $sys_sleep
}}

// --- ノベルテキスト --------------------------------------------------------
//
// Content API (`std::game::content`) の下にある低レベルの API である。
// **設定はすべて std 側で解決済み**で、ここに来るのは絶対値だけである
// (`docs/content-api.md` の決めたこと 3)。エンジンは設定を持たない。

// Content を 1 つ積む。まだ描画しない。
//
// - `speed` は秒間何文字出るか
// - `size_unit` は 0 = vw, 1 = vh。`size_value` はその単位に対する値
//   (`Size` は enum なので、wasm の引数に載せるために 2 つに割っている)
// - `weight` は 100 〜 900
// - 色は `r` / `g` / `b` / `a` の 4 つに割って渡す。
//   1 語に詰めないのは、biwa にビット演算が無く、
//   算術で詰めると `a` が i32 の符号を跨ぐためである
[[native(arch="typescript")]]
fn sys_content_push_text(
  text: String, speed: Float,
  size_unit: Uint, size_value: Float,
  weight: Uint,
  r: Uint, g: Uint, b: Uint, a: Uint,
) {{
  pushContentText(text, speed, size_unit, size_value, weight, r, g, b, a);
}}

[[native(arch="wasm")]]
fn sys_content_push_text(
  text: String, speed: Float,
  size_unit: Uint, size_value: Float,
  weight: Uint,
  r: Uint, g: Uint, b: Uint, a: Uint,
) {{
  local.get 0
  local.get 1
  local.get 2
  local.get 3
  local.get 4
  local.get 5
  local.get 6
  local.get 7
  local.get 8
  call $sys_content_push_text
}}

// 積まれた content をまとめて出し始める。
[[native(arch="typescript")]]
fn sys_content_flush() {{
  flushContent();
}}

[[native(arch="wasm")]]
fn sys_content_flush() {{
  call $sys_content_flush
}}

// 枠を空にする。
//
// **エンジンは自分の判断でクリアしない。** いつ消えるかを決めるのは std である
// (決めたこと 2)。待っても消したくない API を将来足すときに、
// 変更がエンジンまで波及しないようにするための切り分けである。
[[native(arch="typescript")]]
fn sys_content_clear() {{
  clearContent();
}}

[[native(arch="wasm")]]
fn sys_content_clear() {{
  call $sys_content_clear
}}

// クリックが来るまで待つ。
// エンジンはクリックが来るまで scene を再開しない。
//
// NOTE: TypeScript ターゲットでは動かない。記述子を返しても、
// これを呼ぶ `content_flush_and_wait` は普通の関数なので
// コンパイラが `yield` を置かない (`docs/content-api.md` の段 2 を参照)。
[[native(arch="typescript")]]
fn wait() -> Syscall {{
  return { sys: Sys.Wait, args: [] };
}}

[[native(arch="wasm")]]
fn wait() {{
  call $sys_wait
}}

// --- 値の変換 --------------------------------------------------------------
//
// エンジン呼び出しではなく、wasm の値に対する操作である。
// `String` の実体はホスト側にしか無いので、数値から作るのもホストに頼む。

[[native(arch="typescript")]]
fn int_to_string(val: Int) -> String {{
  return String(val);
}}

[[native(arch="wasm")]]
fn int_to_string(val: Int) -> String {{
  local.get 0
  call $sys_int_to_string
}}

[[native(arch="typescript")]]
fn float_to_string(val: Float) -> String {{
  return String(val);
}}

[[native(arch="wasm")]]
fn float_to_string(val: Float) -> String {{
  local.get 0
  call $sys_float_to_string
}}
