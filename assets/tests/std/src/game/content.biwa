// Novel message area に表示される、
// テキストを始めとした内容物を content と呼称する。
// 取りうるメディアの形態は以下の通りである:
// - テキスト
// - 画像 (将来的に対応)
// 将来的に拡張される可能性はある。

import package::string::String;
import package::convert::Into;
import package::game::color::Color;
import package::game::config::Config;
import package::game::font::TextWeight;
import package::game::window::Size;
import package::game::base_engine::int_to_string;
import package::game::base_engine::float_to_string;
import package::game::Game;

enum Content {
  Text(TextContent),
}

// 最も標準的な、テキストのcontent
// The basic text `content`.
struct TextContent {
  text: String,
  speed: ContentSpeedLevel,
  size: ContentSizeLevel,
  weight: TextWeight,
  color: ContentColor,
}

impl TextContent {
  // 装飾をいっさい付けないテキスト。すべて設定どおりに出る。
  fn plain(text: String) -> Self {
    Self {
      text = text,
      speed = ContentSpeedLevel::normal(),
      size = ContentSizeLevel::normal(),
      weight = TextWeight::normal(),
      color = ContentColor::Configured,
    }
  }
}

// 文字(content)の速度
struct ContentSpeed {
  // 秒間何文字出るか
  text_per_sec: Float,
}

struct ContentSpeedLevel {
  // 設定された値(ContentSpeed)の何倍か
  // A multiple of the value configured for `std::game::config::Config.user.content_speed`.
  //
  // mul > 0
  mul: Float,
}

impl ContentSpeedLevel {
  fn normal() -> Self {
    Self { mul = 1.0 }
  }
}

struct ContentSizeLevel {
  // 設定された値の何倍か
  // テキスト以外のcontentは行の高さが合うように調整される
  // A multiple of the value configured for `std::game::config::Config.user.content_size`.
  // Any other media kind content than text will be adjusted to fit the line height.
  //
  // mul > 0
  mul: Float,
}

impl ContentSizeLevel {
  fn normal() -> Self {
    Self { mul = 1.0 }
  }
}

enum ContentColor {
  // 設定された値
  // The value configured for `std::game::config::Config.dev.default_text_color`.
  Configured,
  
  // 設定した値
  Value(Color),
}

// impl[T] T: Into[T] { ... } が可能になったら廃止
impl Content: Into[Content] {
  fn into(self) -> Content { self }
}

impl String: Into[Content] {
  fn into(self) -> Content {
    Content::Text(TextContent::plain(self))
  }
}

// 埋め込み式が数値を返すことは多い (`$(player.hp)` など) ので、
// プリミティブにも当てておく。
//
// 孤児規則は「impl 対象か trait 自身のいずれかが自分の package のもの」なので、
// `Into` を定義している std でだけこれが書ける。
impl Int: Into[Content] {
  fn into(self) -> Content {
    Content::Text(TextContent::plain(int_to_string(self)))
  }
}

impl Float: Into[Content] {
  fn into(self) -> Content {
    Content::Text(TextContent::plain(float_to_string(self)))
  }
}

// ---- lang item APIs for compiler ----
//
// scene の生テキストと `$` の埋め込み式、`>>` の展開先である。
// コンパイラのみが呼び出すことを想定しており、
// ゲーム開発者やサードパーティが直接呼ぶことは想定していない。

[[lang="content_push"]]
fn content_push[C: Into[Content], T, U](game: Game[T, U], content: C) {
  let c: Content = content.into();
  match c {
    Content::Text(text) => {
      game.window.message_window.push_text(
        text.text,
        resolved_speed(game.config, text.speed),
        resolved_size(game.config, text.size),
        text.weight,
        resolved_color(game.config, text.color),
      );
    }
  }
}

[[lang="content_flush_and_wait"]]
fn content_flush_and_wait[T, U](game: Game[T, U]) {
  game.window.message_window.flush();
  // 将来的に各種イベントを受け取る機構が検討されている。
  // 共通のイベントハンドラをエンジン側が呼び、種類ごとに振り分ける形などが考えられる。
  // game.window.wait_event(Event::MouseClickLeft);
  game.window.wait();
  // **クリアするのはここである。** エンジンは自分の判断で消さない。
  // 「待つが消さない」API を将来足すときに、
  // 変更がコンパイラと std に閉じるようにするための切り分けである。
  game.window.message_window.clear();
}

// ---- 設定の解決 ----
//
// `Content` が持つのは「設定の何倍か」という相対値である。
// syscall には絶対値しか渡さないので、ここで設定と突き合わせて潰す。
// エンジンが設定を持たないのはこのためである。

fn resolved_speed(config: Config, level: ContentSpeedLevel) -> Float {
  config.user.content_speed.text_per_sec * level.mul
}

fn resolved_size(config: Config, level: ContentSizeLevel) -> Size {
  config.user.content_size.mul(level.mul)
}

fn resolved_color(config: Config, color: ContentColor) -> Color {
  match color {
    ContentColor::Configured => config.dev.default_text_color,
    ContentColor::Value(c) => c,
  }
}

// ---- user APIs ----
// scene の埋め込み式記法において、
// 平易な表現を可能にする。
// 
// These APIs provide us to simple and easy-to-use expression
// in scene embeded expression form.
// 
// ## Example:
// 
// ```biwa
// scene foo(g: MyGame) -> MyGame {{
//     Hello! 私の名前は$blue(bold(italic("琵琶")))です。>>
// }}
// ```
// 
// fn red[C: Into[Content]](content: C) -> Content {
//   match content {
//     Content::Text(text) => {
//       text.color = ContentColor::Value(Color::red());
//       Content::Text(text)
//     }
//   }
// }

// ---- user APIs (装飾) ----
//
// scene の埋め込み式で使うための API である。
//
// ```biwa
// scene foo(g: MyGame) -> MyGame {{
//     Hello! 私の名前は$blue(bold("琵琶"))です。>>
// }}
// ```
//
// どれも `Into[Content]` を取って `Content` を返す。
// この形なので入れ子にできる (`blue(bold(..))`)。
//
// NOTE: `italic` や影付けはまだ無い。syscall がその情報を運んでいない
// (`docs/content-api.md` の「装飾をどう運ぶか」を参照)。

// --- 色 ---

// 色を指定する。
fn colored[C: Into[Content]](content: C, color: Color) -> Content {
  set_color(content.into(), ContentColor::Value(color))
}

fn red[C: Into[Content]](content: C) -> Content {
  colored(content, Color::red())
}

fn green[C: Into[Content]](content: C) -> Content {
  colored(content, Color::green())
}

fn blue[C: Into[Content]](content: C) -> Content {
  colored(content, Color::blue())
}

fn white[C: Into[Content]](content: C) -> Content {
  colored(content, Color::white())
}

fn black[C: Into[Content]](content: C) -> Content {
  colored(content, Color::black())
}

// --- 太さ ---

// 太さを指定する。
fn weighted[C: Into[Content]](content: C, weight: TextWeight) -> Content {
  set_weight(content.into(), weight)
}

fn bold[C: Into[Content]](content: C) -> Content {
  weighted(content, TextWeight::bold())
}

fn light[C: Into[Content]](content: C) -> Content {
  weighted(content, TextWeight::light())
}

// --- 大きさ ---
//
// 設定された大きさの何倍かで指定する。絶対値にしないのは、
// プレイヤーが文字サイズを変えたときに追従させるためである。
//
// 入れ子にすると掛け合わさる (`big(big(x))` は 4 倍)。

fn sized[C: Into[Content]](content: C, mul: Float) -> Content {
  scale_size(content.into(), mul)
}

fn big[C: Into[Content]](content: C) -> Content {
  sized(content, 2.0)
}

fn small[C: Into[Content]](content: C) -> Content {
  sized(content, 0.5)
}

// --- 速度 ---
//
// 大きさと同じく、設定された速度の何倍かで指定する。
// 入れ子にすると掛け合わさる。

fn paced[C: Into[Content]](content: C, mul: Float) -> Content {
  scale_speed(content.into(), mul)
}

fn fast[C: Into[Content]](content: C) -> Content {
  paced(content, 2.0)
}

fn slow[C: Into[Content]](content: C) -> Content {
  paced(content, 0.5)
}

// ---- 装飾の実体 ----
//
// ジェネリクスを剥がしてから 1 箇所で書き換える。
// メディアの種類が増えたら、それを気にするのはこの 4 つだけになる。

fn set_color(content: Content, color: ContentColor) -> Content {
  match content {
    Content::Text(text) => {
      text.color = color;
      Content::Text(text)
    }
  }
}

fn set_weight(content: Content, weight: TextWeight) -> Content {
  match content {
    Content::Text(text) => {
      text.weight = weight;
      Content::Text(text)
    }
  }
}

fn scale_size(content: Content, mul: Float) -> Content {
  match content {
    Content::Text(text) => {
      text.size = ContentSizeLevel { mul = text.size.mul * mul };
      Content::Text(text)
    }
  }
}

fn scale_speed(content: Content, mul: Float) -> Content {
  match content {
    Content::Text(text) => {
      text.speed = ContentSpeedLevel { mul = text.speed.mul * mul };
      Content::Text(text)
    }
  }
}
