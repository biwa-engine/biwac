import package::types::option::Option;

[[native(arch="typescript")]]
type Vec[T] = {{
  Array<T>
}};

[[native(arch="typescript")]]
type Map[K, V] = {{
  Map<K, V>
}};

impl[K, V] Map[K, V] {
  [[native(arch="typescript")]]
  fn insert(self, key: K, value: V) {{
    self.set(key, value);
  }}
  
  // T? ( Option[T] ) のtypescript実装では None は null として扱われる
  // Map.prototype.get(key)は値がなければundefinedを返すので、nullに変換
  [[native(arch="typescript")]]
  fn get(self, key: K) -> Option[V] {{
    let value = self.get(key);
    if(value) {
      return value;
    } else {
      return null;
    }
  }}
}
