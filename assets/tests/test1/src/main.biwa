import math::pos::Pos;
import math::pos::Pos::new;
import collections::Pair;
import collections::Vec;

type PairIntT[T] = Pair[Int, T];

fn add(x: Int, y: Int) -> Int {
    return x + y;
}

fn foo() {
  let x = add(3, 2);
  let y = math::fact(x);
  let l = math::line::Line{
    begin = Pos::new(0, x),
    end = Pos::new(11, y),
  };
  let z = native_add(3, 2);
  let pair = Pair::new(l, z);
  let aa = Pair::new(x, pair.y()).add();
  // 型引数が埋まりきっていないエイリアス越しの呼び出し。
  // 呼び出し位置の self 型は使えないので、引数からの推論に落ちる。
  let ab = PairIntT::new(0, aa).x();
}

[[native(arch="typescript")]]
fn native_add(x: Int, y: Int) -> Int {{
  console.log("Hello, TypeScript World!");
  return x + y;
}}

// 同じ名前で arch 違いの native を並べる。
// 選ばれていない arch のものは def collection の前に落とされるので、
// シンボルは衝突しない。
[[native(arch="wasm")]]
fn native_add(x: Int, y: Int) -> Int {{
  local.get 0
  local.get 1
  i32.add
}}

// 依存パッケージ greeter の API を使う。
//
// greeter のシグニチャには greeter 自身ではなく
// その依存 (std, color) で定義された型が現れる。
// これらが .biwameta 越しに正しく復元できるかの検証。
fn greeting_demo() {
  // 引数・戻り値の型は greeter から見て外部の型 (std の String)。
  let msg = greeter::greet("Hello");

  // struct のメンバの型も std の String。
  let g = greeter::Greeting::new(msg);
  let m = g.message();

  // 戻り値は color の型。test1 は color に依存していないので
  // `color::Rgb` と名前で書くことはできないが、型としては流れてくる。
  // 解決には推移的依存のメタデータがロードされている必要がある。
  let c = greeter::theme();
  let red = c.r;
}

// 型エイリアス越しに外部パッケージの関連関数を引く。
//
// エイリアスの右辺が外部パッケージの型を指すとき、canonical な型は
// 自パッケージの名前ツリーに居ない。依存メタデータの view まで降りて
// 関連アイテムを引けているかの検証である。
type ExtGreeting = greeter::Greeting;      // 非ジェネリックな外部型
type IntBox = greeter::Box[Int];           // ジェネリックな外部型 (型引数つき)
type IntBox2 = IntBox;                     // エイリアスの連鎖
type PairIntInt = Pair[Int, Int];          // 自パッケージの型 (回帰確認)
type IntVec = Vec[Int];                    // 型引数がエイリアスからしか決まらない

fn alias_assoc_demo() {
  let g = ExtGreeting::new(greeter::greet("Hi"));
  let m = g.message();

  let b = IntBox::new(1);
  let n = b.get();

  let b2 = IntBox2::new(2);
  let n2 = b2.get();

  let p = PairIntInt::new(3, 4).add();

  // `new()` の型引数は戻り値にしか現れず、以降どこからも決まらない。
  // エイリアスに書かれた `Int` で決まらなければ単相化できない。
  let v = IntVec::new();
}

// 単相化の根はランタイムが呼ぶ scene (main) だけなので、
// そこから辿れない関数は成果物に入らない。
// scene main が foo() と greeting_demo() を呼んでいるのは、
// ジェネリクスの実体化と、パッケージをまたぐ実体化を通すためである。
//
//  - foo()            -> Pair::new が [Int, Int] と [Line, Int] の 2 通りに実体化される
//  - greeting_demo()  -> greeter (直接依存) と color / std (推移的依存) を引き込む

struct MyGameState {}

struct MyGameCharacters {}

type MyGame = std::game::Game[MyGameCharacters, MyGameState];

scene main(g: MyGame) -> MyGame {{
  Hello, World!
  #let x = native_add(1, 2)
  #if x > 2 {
    Nice!
  }

  hogehoge~~~

  #foo()
  #greeting_demo()
  #alias_assoc_demo()

  #endscene g
}}
