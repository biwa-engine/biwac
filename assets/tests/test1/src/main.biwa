import math::pos::Pos;
import math::pos::Pos::new;
import collections::Pair;

type PairIntT[T] = Pair[Int, T];

fn add(x: Int, y: Int) -> Int {
    return x + y;
}

fn foo() {
  let x = add(3, 2);
  let y = math::fact(x);
  let l = math::line::Line{
    begin = Pos::new(0, x),
    end = Pos::new(11, y),
  };
  let z = native_add(3, 2);
  let pair = Pair::new(l, z);
  let aa = Pair::new(x, pair.y()).add();
  // let ab = PairIntT::new(0, aa).x();
}

[[native(arch="typescript")]]
fn native_add(x: Int, y: Int) -> Int {{
  console.log("Hello, TypeScript World!");
  return x + y;
}}

// 依存パッケージ greeter の API を使う。
//
// greeter のシグニチャには greeter 自身ではなく
// その依存 (std, color) で定義された型が現れる。
// これらが .biwameta 越しに正しく復元できるかの検証。
fn greeting_demo() {
  // 引数・戻り値の型は greeter から見て外部の型 (std の String)。
  let msg = greeter::greet("Hello");

  // struct のメンバの型も std の String。
  let g = greeter::Greeting::new(msg);
  let m = g.message();

  // 戻り値は color の型。test1 は color に依存していないので
  // `color::Rgb` と名前で書くことはできないが、型としては流れてくる。
  // 解決には推移的依存のメタデータがロードされている必要がある。
  let c = greeter::theme();
  let red = c.r;
}

struct MyGameState {}

struct MyGameCharacters {}

type MyGame = std::game::Game[MyGameCharacters, MyGameState];

scene main(g: MyGame) -> MyGame {{
  Hello, World!
  #let x = native_add(1, 2)
  #if x > 2 {
    Nice!
  }

  hogehoge~~~
  
  #endscene g
}}
