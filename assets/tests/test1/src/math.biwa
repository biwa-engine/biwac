fn fact(n: Int) -> Int {
  if n == 0 {
    1
  } else {
    n * fact(n - 1)
  }
}

[[native(arch="typescript")]]
fn native_sqrt(x: Int) -> Float {{
  return Math.sqrt(x);
}}

[[native(arch="wasm")]]
fn native_sqrt(x: Int) -> Float {{
  local.get 0
  f32.convert_i32_s
  f32.sqrt
}}

// NOTE: プリミティブ型への実装は、将来stdに限定される予定。
// その際にはエラーになるべき。
impl Int {
  fn sqrt(self) -> Float {
    native_sqrt(self)
  }
}
